{
  "name": "edgemirror-fixture-bindings",
  "main": "src/index.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "EM_ENV": "bindings-fixture",
    "EM_MARK": "edgemirror-vars-ok"
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgemirror-bindings",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "edgemirror-bindings-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER",
        "class_name": "Counter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["Counter"]
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "QUEUE",
        "queue": "edgemirror-bindings-queue"
      }
    ],
    "consumers": [
      {
        "queue": "edgemirror-bindings-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 1
      }
    ]
  },
  "services": [
    {
      "binding": "HELPER",
      "service": "edgemirror-fixture-bindings",
      "entrypoint": "HelperEntrypoint"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
