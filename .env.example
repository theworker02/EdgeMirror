# EdgeMirror environment (example)
# Copy to .env.local / .env.stripe.local — never commit secrets.

# Cloudflare (for preview / remote / pitch-demo)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Stripe Billing (prefer TEST keys for catalog setup)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_DEVELOPER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# EDGEMIRROR_PUBLIC_BASE_URL=http://localhost:8787
