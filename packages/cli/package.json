{
  "name": "edgemirror",
  "version": "0.1.0",
  "description": "Production parity testing for Cloudflare Workers",
  "type": "module",
  "bin": {
    "edgemirror": "./dist/cli/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --dir src",
    "test:cloudflare-live": "vitest run --config ../../tests/cloudflare-live/vitest.config.ts",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "parity",
    "differential-testing",
    "workerd",
    "wrangler",
    "edgemirror"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theworker02/EdgeMirror.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/theworker02/EdgeMirror#readme",
  "bugs": {
    "url": "https://github.com/theworker02/EdgeMirror/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.1",
    "zod": "^3.24.2"
  },
  "peerDependencies": {
    "wrangler": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "wrangler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "wrangler": "^4.135.0"
  }
}
