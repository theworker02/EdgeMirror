{
  "name": "@edgemirror/ui",
  "version": "1.4.0",
  "description": "EdgeMirror design system — status language, tokens, and product UI primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./components.css": "./src/components.css",
    "./index.css": "./src/index.css"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No unit tests in @edgemirror/ui yet\" && exit 0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "typescript": "^5.8.2"
  }
}
